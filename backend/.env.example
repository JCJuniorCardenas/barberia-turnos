# PostgreSQL local o DATABASE_URL provista por Railway
NODE_ENV=development
PORT=3000

# En Railway, usar DATABASE_URL y dejar estas variables sin completar.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=barberia_turnos

# Se utilizará en la siguiente etapa para autenticación JWT
JWT_SECRET=cambiar-por-un-secreto-seguro
ADMIN_EMAIL=admin@elvasco.com
ADMIN_PASSWORD=cambiar-por-una-clave-segura

# Configuración futura de la barbería
BARBERSHOP_NAME=El Vasco
WHATSAPP_NUMBER=5490000000000
